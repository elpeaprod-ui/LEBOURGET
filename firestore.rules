rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonctions d'aide
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Profils utilisateurs
    // Le téléphone n'est visible que par son propriétaire, ou en cas de réservation acceptée
    match /profils/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) 
                    && request.resource.data.telephone is string
                    && request.resource.data.telephone.matches('^(\\+33|0)[1-9](\\d{2}){4}$');
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Trajets de covoiturage solidaire
    match /trajets/{trajetId} {
      allow read: if true;
      allow create: if isEmailVerified() 
                    && request.resource.data.conducteurId == request.auth.uid
                    && request.resource.data.placesDisponibles >= 1
                    && request.resource.data.placesDisponibles <= 8
                    && request.resource.data.prixParPlace <= 45; // Plafond maximal strict de partage de frais
      allow update: if isEmailVerified() && (resource.data.conducteurId == request.auth.uid || isAdmin());
      allow delete: if isEmailVerified() && (resource.data.conducteurId == request.auth.uid || isAdmin());
    }

    // Réservations de places
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.passagerId == request.auth.uid || 
        resource.data.conducteurId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEmailVerified() 
                    && request.resource.data.passagerId == request.auth.uid;
      allow update: if isEmailVerified() && (
        resource.data.conducteurId == request.auth.uid || 
        resource.data.passagerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isEmailVerified() && (
        resource.data.passagerId == request.auth.uid || isAdmin()
      );
    }

    // Conversations & Messagerie instantanée sécurisée
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isEmailVerified() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.expediteurId == request.auth.uid
        );
      }
    }

    // Signalements citoyens & modération
    match /signalements/{sigId} {
      allow create: if isAuthenticated() && request.resource.data.signaleurId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Avis après trajet
    match /avis/{avisId} {
      allow read: if true;
      allow create: if isEmailVerified() && request.resource.data.auteurId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
