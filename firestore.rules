rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Fonctions d'aide
    // ---------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------
    // Profils : données publiques pour les membres connectés (sans téléphone)
    // ---------------------------------------------------------------
    match /profils/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
                    && request.resource.data.note == 0
                    && request.resource.data.avisCount == 0;
      // Le propriétaire ne peut pas modifier lui-même sa note ni son nombre d'avis
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['note', 'avisCount']))
                    || isAdmin();
      allow delete: if isAdmin();

      // Téléphone privé : visible uniquement par son propriétaire
      match /prive/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && docId == 'contact'
                              && request.resource.data.telephone is string
                              && request.resource.data.telephone.matches('^(\\+33|0)[1-9](\\d{2}){4}$');
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------
    // Trajets de covoiturage solidaire
    // ---------------------------------------------------------------
    match /trajets/{trajetId} {
      // Chemin de la réservation du demandeur pour ce trajet (id = trajetId_uid)
      function myReservation() {
        return /databases/$(database)/documents/reservations/$(trajetId + '_' + request.auth.uid);
      }

      function onlyPlacesChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['placesDisponibles']);
      }

      function placesInRange() {
        return request.resource.data.placesDisponibles >= 0
            && request.resource.data.placesDisponibles <= resource.data.placesTotal;
      }

      // Un passager retire exactement les places de sa nouvelle réservation (créée dans la même opération)
      function isMyBooking() {
        return !exists(myReservation())
            && existsAfter(myReservation())
            && getAfter(myReservation()).data.trajetId == trajetId
            && resource.data.placesDisponibles - request.resource.data.placesDisponibles
               == getAfter(myReservation()).data.places;
      }

      // Un passager rend exactement les places de sa réservation supprimée dans la même opération
      function isMyCancellation() {
        return exists(myReservation())
            && !existsAfter(myReservation())
            && request.resource.data.placesDisponibles - resource.data.placesDisponibles
               == get(myReservation()).data.places;
      }

      allow read: if true;
      allow create: if isEmailVerified()
                    && request.resource.data.conducteurId == request.auth.uid
                    && request.resource.data.placesTotal >= 1
                    && request.resource.data.placesTotal <= 8
                    && request.resource.data.placesDisponibles == request.resource.data.placesTotal
                    && request.resource.data.prixParPlace >= 0
                    && request.resource.data.prixParPlace <= 45; // Plafond maximal strict de partage de frais
      allow update: if isEmailVerified() && (
                      resource.data.conducteurId == request.auth.uid
                      || isAdmin()
                      || (onlyPlacesChanged() && placesInRange() && (isMyBooking() || isMyCancellation()))
                    );
      allow delete: if isEmailVerified() && (resource.data.conducteurId == request.auth.uid || isAdmin());

      // Téléphone du conducteur : lisible par lui-même et par les passagers à réservation confirmée
      match /contact/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/trajets/$(trajetId)).data.conducteurId == request.auth.uid
          || (exists(/databases/$(database)/documents/reservations/$(trajetId + '_' + request.auth.uid))
              && get(/databases/$(database)/documents/reservations/$(trajetId + '_' + request.auth.uid)).data.statut == 'confirmee')
          || isAdmin()
        );
        allow create, update: if isEmailVerified()
                              && docId == 'phone'
                              && getAfter(/databases/$(database)/documents/trajets/$(trajetId)).data.conducteurId == request.auth.uid
                              && request.resource.data.telephone is string
                              && request.resource.data.telephone.matches('^(\\+33|0)[1-9](\\d{2}){4}$');
        allow delete: if isEmailVerified()
                      && get(/databases/$(database)/documents/trajets/$(trajetId)).data.conducteurId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------
    // Réservations de places (id = trajetId_passagerId : une seule par passager et par trajet)
    // ---------------------------------------------------------------
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.passagerId == request.auth.uid ||
        resource.data.conducteurId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEmailVerified()
                    && request.resource.data.passagerId == request.auth.uid
                    && reservationId == request.resource.data.trajetId + '_' + request.auth.uid
                    && request.resource.data.statut == 'confirmee'
                    && request.resource.data.places >= 1
                    && request.resource.data.places <= get(/databases/$(database)/documents/trajets/$(request.resource.data.trajetId)).data.placesDisponibles
                    && request.resource.data.conducteurId == get(/databases/$(database)/documents/trajets/$(request.resource.data.trajetId)).data.conducteurId
                    && request.resource.data.conducteurId != request.auth.uid;
      // Seul le conducteur peut changer le statut (acceptation / refus)
      allow update: if isEmailVerified()
                    && resource.data.conducteurId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
                    || isAdmin();
      // Le passager annule en supprimant sa réservation
      allow delete: if isEmailVerified() && (resource.data.passagerId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------------
    // Conversations & messagerie (participantIds = les 2 identifiants)
    // ---------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isEmailVerified()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow create: if isEmailVerified()
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                      && request.resource.data.expediteurId == request.auth.uid;
        // Le destinataire peut seulement marquer un message comme lu
        allow update: if isAuthenticated()
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                      && resource.data.expediteurId != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      }
    }

    // ---------------------------------------------------------------
    // Signalements citoyens & modération (lecture réservée aux admins)
    // ---------------------------------------------------------------
    match /signalements/{sigId} {
      allow create: if isAuthenticated()
                    && request.resource.data.signaleurId == request.auth.uid
                    && request.resource.data.statut == 'en_attente';
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Avis après trajet
    // ---------------------------------------------------------------
    match /avis/{avisId} {
      allow read: if true;
      allow create: if isEmailVerified() && request.resource.data.auteurId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
