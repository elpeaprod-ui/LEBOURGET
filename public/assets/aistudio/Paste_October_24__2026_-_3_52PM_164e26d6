              setSelectedTripId(id);
              setCurrentPage('detail');
            }}
            onGoPublish={() => setCurrentPage('publier')}
          />
        )}

        {currentPage === 'detail' && selectedTrip && (
          <DetailTrajetView 
            trip={selectedTrip}
            currentUser={user}
            bookings={bookings}
            onBack={() => setCurrentPage('recherche')}
            onBook={(tripId) => {
              if (selectedTrip.placesDisponibles <= 0) {
                showToast("Désolé, ce trajet est complet.");
                return;
              }
              const newBooking = {
                id: `book-${Date.now()}`,
                trajetId: tripId,
                passagerId: user.id,
                passagerNom: `${user.prenom} ${user.nom}`,
                passagerTel: user.telephone,
                places: 1,
                statut: "confirmee" // direct pour simplifier la démo citoyenne
              };
              setBookings([...bookings, newBooking]);
              setTrips(trips.map(t => t.id === tripId ? { ...t, placesDisponibles: t.placesDisponibles - 1 } : t));
              showToast("Ta place est réservée solidairement ! Le numéro du conducteur est maintenant débloqué.");
