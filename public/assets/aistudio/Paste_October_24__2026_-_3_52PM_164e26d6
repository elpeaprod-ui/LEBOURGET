2. Règles de sécurité Firestore (firestore.rules)

Ces règles garantissent :

    L'anonymat du numéro de téléphone : uniquement lisible si l'utilisateur consulte son propre profil, ou s'il existe une réservation acceptée entre le passager et le conducteur.

    La vérification email obligatoire (request.auth.token.email_verified == true) pour publier ou réserver.

    L'intégrité financière bénévole : plafonnement des frais par passager pour interdire toute spéculation commerciale.

    L'isolation des messages aux seuls interlocuteurs de la conversation.

code JavaScript

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonctions d'aide
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Profils utilisateurs
    match /profils/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) 
                    && request.resource.data.telephone is string
                    && request.resource.data.telephone.matches('^(\\+33|0)[1-9](\\d{2}){4}$');
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Trajets
    match /trajets/{trajetId} {
      allow read: if true;
      allow create: if isEmailVerified() 
                    && request.resource.data.conducteurId == request.auth.uid
                    && request.resource.data.placesDisponibles >= 1
                    && request.resource.data.placesDisponibles <= 8
                    && request.resource.data.prixParPlace <= 45; // Plafond maximal de contribution aux frais
      allow update: if isEmailVerified() && (resource.data.conducteurId == request.auth.uid || isAdmin());
      allow delete: if isEmailVerified() && (resource.data.conducteurId == request.auth.uid || isAdmin());
    }

    // Réservations
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.passagerId == request.auth.uid || 
        resource.data.conducteurId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEmailVerified() 
                    && request.resource.data.passagerId == request.auth.uid;
      allow update: if isEmailVerified() && (
        resource.data.conducteurId == request.auth.uid || 
        resource.data.passagerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isEmailVerified() && (
        resource.data.passagerId == request.auth.uid || isAdmin()
      );
    }

    // Conversations & Messagerie instantanée
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isEmailVerified() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.expediteurId == request.auth.uid
        );
      }
    }

    // Signalements citoyens
    match /signalements/{sigId} {
      allow create: if isAuthenticated() && request.resource.data.signaleurId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Avis après trajet
    match /avis/{avisId} {
      allow read: if true;
      allow create: if isEmailVerified() && request.resource.data.auteurId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}

