            onClick={() => setActiveTab("proposes")}
            className={`px-4 py-2 text-xs font-bold uppercase tracking-wider ${activeTab === 'proposes' ? 'bg-[#0A1128] text-white' : 'text-slate-600 hover:bg-slate-50'}`}
          >
            Mes annonces ({userTrips.length})
          </button>
        </div>
      </div>

