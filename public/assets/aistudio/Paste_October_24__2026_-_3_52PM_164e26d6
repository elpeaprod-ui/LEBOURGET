function ProposerTrajetView({ currentUser, onTripCreated, onCancel }) {
  const [villeDepart, setVilleDepart] = useState("");
  const [adresseDepart, setAdresseDepart] = useState("");
  const [typeTrajet, setTypeTrajet] = useState("aller-retour");
  const [heureDepart, setHeureDepart] = useState("10:00");
  const [heureRetour, setHeureRetour] = useState("19:30");
  const [places, setPlaces] = useState(3);
  const [distanceKm, setDistanceKm] = useState(180);
  const [prixParPlace, setPrixParPlace] = useState(12);
  const [vehicule, setVehicule] = useState(currentUser.vehicule || "Renault Clio");
  const [nonFumeur, setNonFumeur] = useState(true);
  const [pmr, setPmr] = useState(false);
  const [description, setDescription] = useState("");

  // Plafond légal solidaire
  const prixMaxAutorise = Math.max(5, Math.round(distanceKm * EVENT_CONFIG.costCapPerKm));

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!villeDepart || !adresseDepart) {
      alert("Veuillez remplir la ville et l'adresse de départ.");
      return;
    }

    if (prixParPlace > prixMaxAutorise) {
      alert(`Par respect des règles de non-profit citoyen, le prix ne peut dépasser le plafond de ${prixMaxAutorise} € pour cette distance.`);
      return;
    }

    const newTrip = {
      id: `trip-${Date.now()}`,
      conducteurId: currentUser.id,
      conducteurNom: `${currentUser.prenom} ${currentUser.nom}`,
      conducteurBio: currentUser.bio,
      conducteurNote: 5.0,
      conducteurAvisCount: 1,
      conducteurTel: currentUser.telephone,
      villeDepart,
      adresseDepart,
      destination: "Parc des expositions Paris Le Bourget",
      date: "2026-11-07",
      heureDepart,
      heureArriveeEstimee: "12h45",
      typeTrajet,
      heureRetour: typeTrajet === 'aller-retour' ? heureRetour : null,
      placesTotal: Number(places),
      placesDisponibles: Number(places),
      prixParPlace: Number(prixParPlace),
      distanceKm: Number(distanceKm),
      vehicule,
      regles: { bagages: "Standard", nonFumeur, animaux: false, pmr },
      description: description || "En route ensemble pour le 7 novembre !"
    };

    onTripCreated(newTrip);
  };

  return (
    <div className="max-w-3xl mx-auto px-4 py-8">
      <div className="bg-white border-t-4 border-[#E4002B] p-6 md:p-8 shadow-md">
        <h1 className="font-display text-3xl md:text-4xl uppercase text-slate-900 mb-1">
          PROPOSER DES PLACES DANS MON VÉHICULE
        </h1>
        <p className="text-slate-600 text-sm mb-6">
          Remplis ce formulaire pour aider des camarades et citoyens à se rendre au meeting.
        </p>

        {/* ENCADRÉ CONSEIL HORAIRE 13H */}
        <div className="bg-amber-50 border-l-4 border-amber-500 p-4 mb-6 text-xs text-amber-900 leading-relaxed">
          <strong>Recommandation essentielle d'organisation :</strong> Le grand meeting débute à 15h. Ajuste ton heure de départ pour viser une arrivée vers <strong>13h à l'ouverture des portes</strong> afin d'éviter les files d'attente.
        </div>

        <form onSubmit={handleSubmit} className="space-y-6">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Ville de départ *</label>
              <input 
                type="text" 
                required 
                placeholder="Ex: Rouen, Rennes, Dijon..."
                value={villeDepart}
                onChange={(e) => setVilleDepart(e.target.value)}
                className="w-full p-2.5 border border-slate-300 text-sm focus:border-[#E4002B] outline-none"
              />
            </div>

            <div>
              <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Lieu précis de rendez-vous *</label>
              <input 
                type="text" 
                required 
                placeholder="Ex: Parking Gare, Sortie métro..."
                value={adresseDepart}
                onChange={(e) => setAdresseDepart(e.target.value)}
                className="w-full p-2.5 border border-slate-300 text-sm focus:border-[#E4002B] outline-none"
              />
            </div>
          </div>

          <div>
            <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Destination finale</label>
            <input 
              type="text" 
              disabled 
              value="Parc des expositions Paris Le Bourget, Carrefour Charles Lindbergh, 93350 Le Bourget"
              className="w-full p-2.5 bg-slate-100 border border-slate-300 text-xs text-slate-600 cursor-not-allowed font-medium"
            />
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Formule</label>
              <select 
                value={typeTrajet}
                onChange={(e) => setTypeTrajet(e.target.value)}
                className="w-full p-2.5 border border-slate-300 text-sm bg-white"
              >
                <option value="aller-retour">Aller-retour (7 novembre)</option>
                <option value="aller-simple">Aller simple (7 novembre)</option>
              </select>
            </div>

            <div>
              <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Heure de départ</label>
              <input 
                type="time" 
                value={heureDepart}
                onChange={(e) => setHeureDepart(e.target.value)}
                className="w-full p-2 border border-slate-300 text-sm"
              />
            </div>

            {typeTrajet === 'aller-retour' && (
              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Heure de retour (estimée)</label>
                <input 
                  type="time" 
                  value={heureRetour}
                  onChange={(e) => setHeureRetour(e.target.value)}
                  className="w-full p-2 border border-slate-300 text-sm"
                />
              </div>
            )}
          </div>

          {/* PLAFONNEMENT LÉGAL AU KM SANS PROFIT */}
          <div className="p-4 bg-slate-50 border border-slate-200 space-y-4">
            <h4 className="font-display text-lg uppercase text-slate-800">
              Partage équitable des frais réels
            </h4>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Distance approx. (km)</label>
                <input 
                  type="number" 
                  min="10" 
                  max="1000"
                  value={distanceKm}
                  onChange={(e) => setDistanceKm(Number(e.target.value))}
                  className="w-full p-2 border border-slate-300 text-sm"
                />
              </div>

              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Nombre de places libres</label>
                <input 
                  type="number" 
                  min="1" 
                  max="8" 
                  value={places}
                  onChange={(e) => setPlaces(Number(e.target.value))}
                  className="w-full p-2 border border-slate-300 text-sm"
                />
              </div>

              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">
                  Participation demandée (€)
                </label>
                <input 
                  type="number" 
                  min="0" 
                  max={prixMaxAutorise} 
                  value={prixParPlace}
                  onChange={(e) => setPrixParPlace(Number(e.target.value))}
                  className="w-full p-2 border border-slate-300 text-sm font-bold text-[#E4002B]"
                />
              </div>
            </div>

            <p className="text-xs text-slate-500">
              * <strong>Plafond citoyen imposé :</strong> Pour {distanceKm} km, le montant maximal autorisé est de <strong>{prixMaxAutorise} €</strong> par passager. Tout bénéfice commercial est proscrit.
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Véhicule (modèle & couleur)</label>
              <input 
                type="text" 
                value={vehicule}
                onChange={(e) => setVehicule(e.target.value)}
                className="w-full p-2.5 border border-slate-300 text-sm"
                placeholder="Ex: Dacia Sandero rouge"
              />
            </div>

            <div className="flex items-center gap-6 pt-5">
              <label className="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input 
                  type="checkbox" 
                  checked={nonFumeur} 
                  onChange={(e) => setNonFumeur(e.target.checked)} 
                  className="accent-[#E4002B] w-4 h-4"
                />
                Non-fumeur
              </label>
              <label className="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                <input 
                  type="checkbox" 
                  checked={pmr} 
                  onChange={(e) => setPmr(e.target.checked)} 
                  className="accent-[#E4002B] w-4 h-4"
                />
                Adapté PMR
              </label>
            </div>
          </div>

          <div>
            <label className="block text-xs font-bold uppercase text-slate-700 mb-1">Précisions & Détours acceptés</label>
            <textarea 
              rows="3"
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              placeholder="Ex: Je peux récupérer des personnes le long de la N104 ou à la gare..."
              className="w-full p-2.5 border border-slate-300 text-sm focus:border-[#E4002B] outline-none"
            ></textarea>
          </div>

          <div className="flex justify-end gap-3 pt-4 border-t border-slate-200">
            <button 
              type="button"
              onClick={onCancel}
              className="px-4 py-2 border border-slate-300 text-xs font-bold uppercase text-slate-600"
            >
              Annuler
            </button>
            <button 
              type="submit"
              className="bg-[#E4002B] hover:bg-[#c90026] text-white px-6 py-2.5 font-display text-xl uppercase tracking-wider transition shadow"
            >
              Mettre en ligne mon trajet
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}

