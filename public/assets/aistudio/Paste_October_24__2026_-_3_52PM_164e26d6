            onGoPublish={() => setCurrentPage('publier')}
            onNavigate={setCurrentPage}
            tripsCount={trips.length}
            seatsCount={totalSeats}
          />
        )}

        {currentPage === 'recherche' && (
          <ResultatsView 
            trips={filteredTrips}
            searchCity={searchDeparture}
            setSearchCity={setSearchDeparture}
            seats={searchSeats}
            setSeats={setSearchSeats}
            filterType={filterType}
