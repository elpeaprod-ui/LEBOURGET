          <button 
            onClick={() => setActiveTab("reserves")}
            className={`px-4 py-2 text-xs font-bold uppercase tracking-wider ${activeTab === 'reserves' ? 'bg-[#0A1128] text-white' : 'text-slate-600 hover:bg-slate-50'}`}
          >
